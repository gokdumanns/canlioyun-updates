{
  "id": "hipodrom-3d",
  "name": "Süper Hipodrom 3D",
  "version": "1.2.2",
  "description": "7 kulvarlı dev 3D hipodromda hamam böceği jokeyler yarışıyor! Kalan izleyiciler tribünlerde kamerayla bitişe kadar koşuyor, hediyelerle sahaya 3D domates, çamur, bal ve halat atıp yarışı sabote ediyor; koşulu sağlayanlar sıraya girip sonraki koşuda ata biniyor!",
  "engine": "three",
  "entry": "index.js",
  "tags": ["3D", "yarış", "komedi", "sabotaj", "sıra"],
  "ui": { "legend": "none" },
  "actions": [
    { "id": "join_lane", "label": "Ata Bin / Kulvar Seç", "icon": "🏇", "description": "Boş kulvara bindirir; 7 at doluysa izleyiciyi yarış sırasına alır ve tribünde koşturur.",
      "params": [{ "key": "lane", "label": "Kulvar", "type": "select", "default": "0",
        "options": [
          { "value": "0", "label": "1. Kulvar (Kırmızı)" },
          { "value": "1", "label": "2. Kulvar (Mavi)" },
          { "value": "2", "label": "3. Kulvar (Yeşil)" },
          { "value": "3", "label": "4. Kulvar (Sarı)" },
          { "value": "4", "label": "5. Kulvar (Mor)" },
          { "value": "5", "label": "6. Kulvar (Turuncu)" },
          { "value": "6", "label": "7. Kulvar (Turkuaz)" }
        ] }] },
    { "id": "join_queue", "label": "Yarış Sırasına Gir", "icon": "🎟️", "description": "Katılım koşulunu sağlayan izleyiciyi boş ata bindirir veya bir sonraki yarış sırasına alır.",
      "params": [] },
    { "id": "set_gender", "label": "Kıyafet Değiştir", "icon": "👗", "description": "Hamam böceği jokeyin kıyafetini kadın veya erkek yapar.",
      "params": [{ "key": "gender", "label": "Tarz", "type": "select", "default": "f",
        "options": [{ "value": "f", "label": "Kadın (Elbise & Taç)" }, { "value": "m", "label": "Erkek (Ceket, Şapka & Bıyık)" }] }] },
    { "id": "cheer", "label": "Atı Koştur", "icon": "💨", "description": "Jokeyin atına (veya tribündeyse rastgele desteklediği ata) hız desteği verir.",
      "params": [{ "key": "power", "label": "Hız", "type": "number", "default": 1, "min": 1, "max": 10 }] },
    { "id": "stand_up", "label": "At Üstünde Şov", "icon": "🤸", "description": "Hamam böceği jokey atın sırtında ayağa kalkıp kollarını sallayarak sörf şovu yapar (+hafif hız).",
      "params": [{ "key": "seconds", "label": "Saniye", "type": "number", "default": 5, "min": 2, "max": 10 }] },
    { "id": "play_davul", "label": "Davul Çal", "icon": "🥁", "description": "Jokey atın üstünde ayağa kalkıp tokmakla Anadolu davulu çalar (+hız ve şov!).",
      "params": [{ "key": "seconds", "label": "Saniye", "type": "number", "default": 6.5, "min": 3, "max": 12 }] },
    { "id": "play_zurna", "label": "Zurna Çal", "icon": "🎺", "description": "Jokey atın üstünde ayağa kalkıp halay zurnası üfler (+hız ve şov!).",
      "params": [{ "key": "seconds", "label": "Saniye", "type": "number", "default": 6.5, "min": 3, "max": 12 }] },
    { "id": "throw_tomato", "label": "Domates Fırlat", "icon": "🍅", "description": "Tribünden liderin kafasına 3D domates yağmuru fırlatır; jokey şapırtıyla sarsılır ve hafif yavaşlar!",
      "params": [] },
    { "id": "throw_mud", "label": "Çamur Bombası", "icon": "🟤", "description": "Tribünden liderin önüne 3D dev çamur bombası fırlatır; hem lideri yavaşlatır hem piste çamur bırakır!",
      "params": [] },
    { "id": "throw_honey", "label": "Bal Tuzağı", "icon": "🍯", "description": "İlk 2 lidere tribünden yapışkan altın bal kavanozu fırlatır; rakipleri yapıştırıp yavaşlatır!",
      "params": [] },
    { "id": "banana", "label": "Muz Kabuğu At", "icon": "🍌", "description": "Liderin kulvarına 3D muz kabuğu bırakır; basan at 360° dönerek kayar (Pegasus üstünden uçar!).",
      "params": [] },
    { "id": "lasso", "label": "Halat / Kement At", "icon": "🤠", "description": "1. sıradaki rakibe ışıklı 3D halat atıp geriye çeker, atan oyuncuyu sapan gibi öne fırlatır!",
      "params": [{ "key": "pull", "label": "Çekme (metre)", "type": "number", "default": 5.5, "min": 2, "max": 9 }] },
    { "id": "mod_flame", "label": "Alev Modifiyesi", "icon": "🔥", "description": "Atın yelesi ve kuyruğu alev alır, turbo hız kazanır.",
      "params": [{ "key": "seconds", "label": "Saniye", "type": "number", "default": 4, "min": 3, "max": 20 }] },
    { "id": "mod_pegasus", "label": "Pegasus Kanatları", "icon": "🪽", "description": "Dev kanatlar çıkar, at havalanır ve çamur/bal/muz engellerinin üstünden uçar!",
      "params": [{ "key": "seconds", "label": "Saniye", "type": "number", "default": 5, "min": 3, "max": 20 }] },
    { "id": "mod_lightning", "label": "Yıldırım Zırhı", "icon": "⚡", "description": "Neon şimşek zırhı takar ve öndeki rakip atı buzla yavaşlatır!",
      "params": [{ "key": "seconds", "label": "Saniye", "type": "number", "default": 5, "min": 3, "max": 20 }] },
    { "id": "mod_unicorn", "label": "Efsanevi Unicorn", "icon": "🦄", "description": "Altın boynuz + gökkuşağı izi + dev hız patlaması!",
      "params": [{ "key": "seconds", "label": "Saniye", "type": "number", "default": 6, "min": 3, "max": 25 }] },
    { "id": "mod_dragon", "label": "Ejderha Kıyameti", "icon": "🐉", "description": "Tüm modifiyeleri birden takar, rakipleri dondurur ve havai fişek patlatır!",
      "params": [{ "key": "seconds", "label": "Saniye", "type": "number", "default": 7, "min": 4, "max": 30 }] }
  ],
  "defaultRules": [
    { "id": "jq", "label": "Sıraya Gir", "trigger": { "type": "chat", "keywords": ["katıl", "katil", "sıra", "sira", "gir", "ben"], "match": "exact" }, "action": "join_queue", "params": {} },
    { "id": "l0", "label": "1. Kulvar", "trigger": { "type": "chat", "keywords": ["1", "kırmızı", "kirmizi"], "match": "exact" }, "action": "join_lane", "params": { "lane": "0" } },
    { "id": "l1", "label": "2. Kulvar", "trigger": { "type": "chat", "keywords": ["2", "mavi"], "match": "exact" }, "action": "join_lane", "params": { "lane": "1" } },
    { "id": "l2", "label": "3. Kulvar", "trigger": { "type": "chat", "keywords": ["3", "yeşil", "yesil"], "match": "exact" }, "action": "join_lane", "params": { "lane": "2" } },
    { "id": "l3", "label": "4. Kulvar", "trigger": { "type": "chat", "keywords": ["4", "sarı", "sari"], "match": "exact" }, "action": "join_lane", "params": { "lane": "3" } },
    { "id": "l4", "label": "5. Kulvar", "trigger": { "type": "chat", "keywords": ["5", "mor"], "match": "exact" }, "action": "join_lane", "params": { "lane": "4" } },
    { "id": "l5", "label": "6. Kulvar", "trigger": { "type": "chat", "keywords": ["6", "turuncu"], "match": "exact" }, "action": "join_lane", "params": { "lane": "5" } },
    { "id": "l6", "label": "7. Kulvar", "trigger": { "type": "chat", "keywords": ["7", "turkuaz"], "match": "exact" }, "action": "join_lane", "params": { "lane": "6" } },
    { "id": "gf", "label": "Kadın Kıyafeti", "trigger": { "type": "chat", "keywords": ["kadın", "kadin", "kız", "kiz", "bayan"], "match": "exact" }, "action": "set_gender", "params": { "gender": "f" } },
    { "id": "gm", "label": "Erkek Kıyafeti", "trigger": { "type": "chat", "keywords": ["erkek", "bay"], "match": "exact" }, "action": "set_gender", "params": { "gender": "m" } },
    { "id": "st", "label": "Ayakta Şov", "trigger": { "type": "chat", "keywords": ["ayakta", "şov", "sov", "sörf", "sorf"], "match": "contains" }, "action": "stand_up", "params": { "seconds": 5 }, "cooldown": 8 },
    { "id": "dv", "label": "Davul Çal", "trigger": { "type": "chat", "keywords": ["davul", "davulcu", "tokmak"], "match": "contains" }, "action": "play_davul", "params": { "seconds": 6.5 }, "cooldown": 9 },
    { "id": "zr", "label": "Zurna Çal", "trigger": { "type": "chat", "keywords": ["zurna", "zurnacı", "zurnaci", "halay"], "match": "contains" }, "action": "play_zurna", "params": { "seconds": 6.5 }, "cooldown": 9 },
    { "id": "tmc", "label": "Domates At", "trigger": { "type": "chat", "keywords": ["domates"], "match": "exact" }, "action": "throw_tomato", "params": {}, "cooldown": 12 },
    { "id": "mdc", "label": "Çamur At", "trigger": { "type": "chat", "keywords": ["çamur", "camur"], "match": "exact" }, "action": "throw_mud", "params": {}, "cooldown": 18 },
    { "id": "bn", "label": "Muz Kabuğu", "trigger": { "type": "chat", "keywords": ["muz"], "match": "exact" }, "action": "banana", "params": {}, "cooldown": 15 },
    { "id": "sh", "label": "Paylaş = Bal", "trigger": { "type": "share" }, "action": "throw_honey", "params": {}, "cooldown": 20 },
    { "id": "ch", "label": "Koş!", "trigger": { "type": "chat", "keywords": ["koş", "kos", "deeh", "hadi", "uç"], "match": "contains" }, "action": "cheer", "params": { "power": 2 } },
    { "id": "lk", "label": "Beğeni = Hız", "trigger": { "type": "like", "every": 4 }, "action": "cheer", "params": { "power": 1 } },
    { "id": "rose", "label": "Domates", "trigger": { "type": "gift", "giftNames": ["Rose", "Gül"], "giftIds": ["5655"], "diamonds": 1 }, "action": "throw_tomato", "params": {} },
    { "id": "g5", "label": "Çamur At", "trigger": { "type": "gift", "minDiamonds": 1, "maxDiamonds": 4 }, "action": "throw_mud", "params": {} },
    { "id": "g15", "label": "Halat At", "trigger": { "type": "gift", "minDiamonds": 5, "maxDiamonds": 9 }, "action": "lasso", "params": { "pull": 5.5 } },
    { "id": "g30", "label": "Pegasus", "trigger": { "type": "gift", "minDiamonds": 10, "maxDiamonds": 29 }, "action": "mod_pegasus", "params": { "seconds": 5 } },
    { "id": "g80", "label": "Unicorn", "trigger": { "type": "gift", "minDiamonds": 30, "maxDiamonds": 98 }, "action": "mod_unicorn", "params": { "seconds": 6 } },
    { "id": "g250", "label": "Ejderha", "trigger": { "type": "gift", "minDiamonds": 99 }, "action": "mod_dragon", "params": { "seconds": 7 } },
    { "id": "fl", "label": "Takip = Alev", "trigger": { "type": "follow" }, "action": "mod_flame", "params": { "seconds": 4 }, "cooldown": 600 }
  ],
  "settings": [
    { "key": "laneCount", "label": "Kulvar sayısı", "type": "select", "default": "7", "options": [{ "value": "5", "label": "5 At" }, { "value": "6", "label": "6 At" }, { "value": "7", "label": "7 At (Önerilen)" }] },
    { "key": "allowBots", "label": "Boş kulvarları botlarla doldur", "description": "Kapatırsan yalnızca gerçek izleyiciler yarışır; boş kulvarlarda bot at olmaz!", "type": "boolean", "default": false },
    { "key": "joinCondition", "label": "Yarışa katılım koşulu", "description": "7 at dolduğunda izleyiciler koşulu sağlayıp sıraya girer (hediye atanlar her zaman VIP öncelik alır)", "type": "select", "default": "easy", "options": [
      { "value": "easy", "label": "Sohbet ('katıl' / 1–7), Takip veya Hediye" },
      { "value": "engage", "label": "Takip Et veya 10+ Beğeni + 'katıl' yaz" },
      { "value": "vip", "label": "Yalnızca Takip veya Hediye (VIP Sıra)" }
    ] },
    { "key": "cameraMode", "label": "Kamera açısı", "type": "select", "default": "auto", "options": [
      { "value": "auto", "label": "Akışkan Drone (Geniş takip + böceklere gir-çık)" },
      { "value": "chase", "label": "Sabit Geniş Takip (Tüm 7 kulvar + tribünler)" },
      { "value": "front", "label": "Ön Karşılama (Jokey yüzleri)" }
    ] },
    { "key": "trackLength", "label": "Pist uzunluğu (metre)", "description": "İdeal yarış süresi (~45 sn) için 420 m önerilir", "type": "number", "default": 420, "min": 220, "max": 700 },
    { "key": "randomEvents", "label": "Pist olayları", "description": "Altın havuç, hız bandı ve çamur tuzakları", "type": "boolean", "default": true },
    { "key": "sound", "label": "Ses efektleri", "type": "boolean", "default": true }
  ]
}
